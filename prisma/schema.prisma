// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(STUDENT)
  expertise String? // JSON string for areas of expertise
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  papers            Paper[]
  annotations       Annotation[]
  annotationLayers  AnnotationLayer[]
  comments          Comment[]
  reactions         Reaction[]
  notes             QuickNote[]
  messages          ChatMessage[]
  stuckHelps           StuckHelp[]
  stuckHelpResponses   StuckHelpResponse[]
  helpeeSessions       PeerExplanationCapture[] @relation("HelpeeCaptures")
  helperSessions       PeerExplanationCapture[] @relation("HelperCaptures")
  conceptConfusions    ConceptConfusion[]
  critiqueAnnotations  CritiqueAnnotation[]
  readingPaceLogs      ReadingPaceLog[]

  @@map("users")
}

model Paper {
  id          String   @id @default(cuid())
  title       String
  filename    String
  filepath    String
  uploadedBy  String
  uploadedAt  DateTime @default(now())
  description String?
  tags        String? // JSON string for academic tags

  // Relationships
  uploader         User              @relation(fields: [uploadedBy], references: [id])
  annotations      Annotation[]
  annotationLayers AnnotationLayer[]
  quickNotes       QuickNote[]
  chatMessages     ChatMessage[]
  stuckHelps       StuckHelp[]
  summaries        AISummary[]
  peerExplanationCaptures PeerExplanationCapture[]
  consensusCheckpoints    ConsensusCheckpoint[]
  conceptConfusions       ConceptConfusion[]
  knowledgeDependencies   KnowledgeDependency[]
  critiqueAnnotations     CritiqueAnnotation[]
  sectionComplexities     SectionComplexity[]
  readingPaceLogs         ReadingPaceLog[]

  @@map("papers")
}

model Annotation {
  id       String         @id @default(cuid())
  paperId  String
  userId   String
  text     String // Selected text
  comment  String // User's comment
  page     Int
  position Json // Position data for highlighting
  type     AnnotationType @default(HIGHLIGHT)
  color    String         @default("#ffeb3b")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relationships
  paper    Paper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id])
  comments Comment[]

  @@map("annotations")
}

model Comment {
  id           String   @id @default(cuid())
  annotationId String
  userId       String
  content      String
  parentId     String? // For threaded replies
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  annotation Annotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])
  parent     Comment?   @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[]  @relation("CommentReplies")

  @@map("comments")
}

model Reaction {
  id           String       @id @default(cuid())
  userId       String
  type         ReactionType
  targetType   String // "annotation" or "comment"
  targetId     String
  createdAt    DateTime     @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId, type])
  @@map("reactions")
}

model QuickNote {
  id        String   @id @default(cuid())
  paperId   String
  userId    String
  section   String // Section identifier
  content   String
  page      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@map("quick_notes")
}

model ChatMessage {
  id        String      @id @default(cuid())
  paperId   String
  userId    String
  content   String
  type      MessageType @default(TEXT)
  metadata  Json? // For AI messages or special content
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relationships
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@map("chat_messages")
}

model StuckHelp {
  id          String     @id @default(cuid())
  paperId     String
  userId      String
  section     String
  description String
  page        Int
  position    Json // Position where user is stuck
  isResolved  Boolean    @default(false)
  isAnonymous Boolean    @default(false)
  status      HelpStatus @default(OPEN)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relationships
  paper     Paper              @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id])
  responses StuckHelpResponse[]

  @@map("stuck_helps")
}

model StuckHelpResponse {
  id          String   @id @default(cuid())
  stuckHelpId String
  userId      String
  content     String
  type        String   @default("human") // "human" or "ai"
  isHelpful   Boolean  @default(false)
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  stuckHelp StuckHelp @relation(fields: [stuckHelpId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@map("stuck_help_responses")
}

model AISummary {
  id        String   @id @default(cuid())
  paperId   String
  section   String
  content   String
  version   Int      @default(1)
  metadata  Json? // Sources, confidence, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, section])
  @@map("ai_summaries")
}

model AnnotationLayer {
  id          String   @id @default(cuid())
  documentId  String   // Maps to Paper.id
  userId      String?  // Nullable for global layers
  xfdf        String   // XFDF content as text
  version     Int      @default(1)
  isGlobal    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  document    Paper    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@unique([documentId, userId]) // One layer per user per document
  @@map("annotation_layers")
}

// Enums
enum UserRole {
  STUDENT
  RESEARCHER
  PROFESSOR
  ADMIN
}

enum AnnotationType {
  HIGHLIGHT
  UNDERLINE
  STRIKETHROUGH
  NOTE
}

enum ReactionType {
  LIKE
  DISLIKE
  ENDORSE
  DISAGREE
  HELPFUL
  CONFUSING
}

enum MessageType {
  TEXT
  AI_RESPONSE
  SYSTEM
  CLARIFICATION
}

enum HelpStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  EXPERT_NEEDED
}

// Peer explanation capture — records what was explained + D_s pre/post for effectiveness measurement
model PeerExplanationCapture {
  id              String   @id @default(cuid())
  paperId         String
  sectionId       String
  sectionName     String
  helpeeId        String
  helpeeName      String
  helperId        String
  helperName      String
  dsAtStart       Float    // D_s score when peer routing fired
  dsAtEnd         Float?   // D_s score 10 min after explanation (null = not yet measured)
  resolved        Boolean? // null = pending follow-up, true/false = user-reported
  helperSummary   String?  // brief description of what was explained (helper fills)
  helpeeRating    Int?     // 1-5 helpfulness rating from helpee
  sessionId       String
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  paper   Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  helpee  User  @relation("HelpeeCaptures", fields: [helpeeId], references: [id])
  helper  User  @relation("HelperCaptures", fields: [helperId], references: [id])

  @@index([paperId, sectionId])
  @@index([helperId])
  @@map("peer_explanation_captures")
}

// Consensus checkpoints — what a group agreed a passage means, stored in Collective Knowledge Base
model ConsensusCheckpoint {
  id              String   @id @default(cuid())
  paperId         String
  sectionId       String
  sectionName     String
  passageText     String   // The passage the agreement is about
  agreedMeaning   String   // What the group agreed it means
  contributors    String   // JSON array of { userId, userName }
  confidence      Float    // 0.0-1.0 — proportion of group who agreed
  sessionId       String
  createdAt       DateTime @default(now())

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId, sectionId])
  @@map("consensus_checkpoints")
}

// Concept confusion map — per-reader, per-paper concept-level understanding tracking
model ConceptConfusion {
  id           String   @id @default(cuid())
  paperId      String
  userId       String
  userName     String
  sectionId    String
  sectionName  String
  conceptLabel String   // "temperature-scaled softmax in Eq. 3"
  passageText  String   // the exact highlighted text
  pageNumber   Int
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([paperId, sectionId])
  @@index([paperId, conceptLabel])
  @@map("concept_confusions")
}

// Knowledge dependency graph — per-paper, generated once on upload
// Encodes which concepts/sections depend on earlier ones
model KnowledgeDependency {
  id             String   @id @default(cuid())
  paperId        String
  fromSectionId  String   // earlier section that defines the concept
  fromSectionName String
  toSectionId    String   // later section that builds on it
  toSectionName  String
  conceptBridge  String   // "the definition of τ in Section 2.3 is used in Section 5's loss function"
  createdAt      DateTime @default(now())

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, fromSectionId, toSectionId])
  @@index([paperId, toSectionId])
  @@map("knowledge_dependencies")
}

// Async marginal annotations — passage-anchored notes for future readers
model MarginalNote {
  id           String   @id @default(cuid())
  paperId      String   // plain string — no FK (Paper table may not exist for all docs)
  authorId     String   // plain string — no FK (flat-file auth system)
  authorName   String
  content      String
  passageText  String
  pageNumber   Int
  sectionName  String?
  createdAt    DateTime @default(now())
  epistemicTag String?
  replies      MarginalNoteReply[]

  @@index([paperId, pageNumber])
  @@map("marginal_notes")
}

// Threaded replies on marginal notes — enables async scholarly dialogue
model MarginalNoteReply {
  id         String   @id @default(cuid())
  noteId     String
  authorId   String   // plain string — not FK-constrained
  authorName String
  content    String
  createdAt  DateTime @default(now())

  note   MarginalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("marginal_note_replies")
}

// Structured debate sessions — A3-facilitated position tracking
model DebateSession {
  id           String   @id @default(cuid())
  documentId   String
  sectionId    String
  sectionName  String
  prompt       String
  groundingQuote String
  sessionId    String
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  convergenceState String? // 'converging' | 'diverging' | 'unresolved'
  sharedUnderstanding String?
  persistentTension   String?

  positions    DebatePosition[]

  @@index([documentId, sectionId])
  @@map("debate_sessions")
}

// Individual position statements within a debate
model DebatePosition {
  id          String   @id @default(cuid())
  debateId    String
  userId      String
  userName    String
  statement   String
  stance      String   // 'support' | 'challenge' | 'qualify' | 'extend'
  quality     Float    @default(0.0)  // AI-assessed 0-1
  createdAt   DateTime @default(now())

  debate DebateSession @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@index([debateId])
  @@map("debate_positions")
}

// Critique annotations — researcher pushback on paper claims
// "I think this conclusion is overstated", "Contradicts Foo et al. 2023"
model CritiqueAnnotation {
  id           String   @id @default(cuid())
  paperId      String
  authorId     String
  authorName   String
  passageText  String   // The exact claim being critiqued
  pageNumber   Int
  sectionName  String?
  critiqueText String   // The researcher's critique
  critiqueType String   // "overstatement" | "contradiction" | "methodology" | "assumption" | "missing-citation" | "other"
  severity     String   @default("medium") // "minor" | "medium" | "major"
  upvotes      Int      @default(0)
  resolved     Boolean  @default(false)
  resolvedNote String?  // how the group resolved this disagreement
  createdAt    DateTime @default(now())

  paper  Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([paperId, pageNumber])
  @@index([paperId, critiqueType])
  @@map("critique_annotations")
}

// Section complexity profiles — cached per paper section
// Used to trigger deeper proactive AI help for dense math/figure sections
model SectionComplexity {
  id              String   @id @default(cuid())
  paperId         String
  sectionId       String
  sectionName     String
  complexityScore Float    // 0.0 - 1.0
  hasMath         Boolean  @default(false)
  hasFigures      Boolean  @default(false)
  hasTables       Boolean  @default(false)
  hasAlgorithms   Boolean  @default(false)
  mathDensity     Float    @default(0.0)  // equations per 100 words
  technicalTerms  String?  // JSON array of key technical terms detected
  readingTimeMin  Float    @default(0.0)  // estimated reading time for this complexity
  createdAt       DateTime @default(now())

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, sectionId])
  @@map("section_complexities")
}

// Reading pace log — per-section pacing data for cohort benchmarks
model ReadingPaceLog {
  id          String   @id @default(cuid())
  paperId     String
  userId      String
  sectionId   String
  sectionName String
  timeSpentMs Int      // actual time spent in ms
  wordCount   Int      // section word count
  complexity  Float    // section complexity at time of reading
  pageCount   Int      // pages in section
  createdAt   DateTime @default(now())

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([paperId, sectionId])
  @@map("reading_pace_logs")
}